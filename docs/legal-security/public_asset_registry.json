{
  "schema_version": 1,
  "rule": "Every tracked binary or geometry file under public/ and every built binary in out/ must match one entry. Unknown assets fail legal-security:validate. Human-readable audit: public_asset_rights_audit.md.",
  "assets": [
    {
      "pattern": "^public/data/boundaries/(v086|sandbox)/[a-z]+_nuts[0-9]_gisco_2024\\.geojson$",
      "origin": "Eurostat/GISCO NUTS 2024",
      "registry_source_id": "src-gisco",
      "status": "ok"
    },
    {
      "pattern": "^public/data/boundaries/v086/(poland|serbia)_adm1_geoboundaries\\.geojson$",
      "origin": "geoBoundaries gbOpen ADM1 (OpenStreetMap, ODbL 1.0)",
      "registry_source_id": "src-geoboundaries",
      "status": "ok"
    },
    {
      "pattern": "^public/geo/adm1/[a-z]+\\.geojson$",
      "origin": "geoBoundaries gbOpen ADM1, per-boundary licences",
      "registry_source_id": "src-geoboundaries",
      "status": "ok"
    },
    {
      "pattern": "^public/geo/home-countries-simplified\\.geojson$",
      "origin": "derived from public/geo/adm1 by scripts/build-home-country-map.mjs",
      "registry_source_id": "src-geoboundaries",
      "status": "ok"
    },
    {
      "pattern": "^out/_next/static/media/[^/]+\\.woff2$",
      "origin": "Geist Mono via next/font, SIL OFL 1.1",
      "registry_source_id": null,
      "status": "ok"
    },
    {
      "pattern": "^out/og/([a-z-]+/)?[^/]+\\.png$",
      "origin": "generated by scripts/build-og-images.mjs from Atlas text",
      "registry_source_id": null,
      "status": "ok"
    },
    {
      "pattern": "^out/research-data/research-data-v[0-9.]+\\.zip$",
      "origin": "Atlas research package",
      "registry_source_id": null,
      "status": "ok"
    }
  ]
}
