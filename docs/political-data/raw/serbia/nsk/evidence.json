  "rights": {
    "statute": {
      "title": "Закон о ауторском и сродним правима (Службени гласник РС 104/2009, 99/2011, 119/2012, 29/2016 – УС, 66/2019)",
      "url": "https://pravno-informacioni-sistem.rs/eli/rep/sgrs/skupstina/zakon/2009/104/30/reg",
      "retrieved_at": "2026-11-15",
      "quoted": {
