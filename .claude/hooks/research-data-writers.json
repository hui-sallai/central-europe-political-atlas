{
  "schema_version": "research-data-writers-v1",
  "purpose": "Backstop for .claude/hooks/lib/research-data-guard.mjs. `writers` are scripts known to write canonical research stores or research outputs under src/data/** or public/research-data/**; running them (directly, via pnpm, or spawned by a dispatcher) always asks the owner, even where static analysis cannot see the write target. `read_only` are validators that import writer modules but were reviewed and do not write (the static scan would otherwise ask). Entries are matched by repository path, not by name pattern.",
  "writers": [
    { "script": "scripts/acquire-eurostat-monthly.mjs", "writes": ["src/data/high-frequency/*", "src/data/analysis/var_readiness.json", "public/research-data/high_frequency_runtime.json"] },
    { "script": "scripts/acquisition/acquire-macro-drivers.py", "writes": ["src/data/macro-drivers/*"] },
    { "script": "scripts/acquisition/acquire-ecb-monetary-events.py", "writes": ["src/data/identified-shocks/*"] },
    { "script": "scripts/historical-annual/acquire.mjs", "writes": ["src/data/historical/annual_*", "src/data/historical/raw/annual/*"] },
    { "script": "scripts/historical-monthly-descriptive/acquire.mjs", "writes": ["src/data/historical/monthly_*", "src/data/historical/raw/monthly/*"] },
    { "script": "scripts/historical-regional/acquire.mjs", "writes": ["src/data/historical/regional_*", "src/data/historical/raw/regional/*"] },
    { "script": "scripts/serbia-sors/ingest.mjs", "writes": ["src/data/serbia/*"] },
    { "script": "scripts/serbia-sors/audit.py", "writes": ["src/data/serbia/serbia_official_data_source_audit.json"] },
    { "script": "scripts/data-coverage/audit.mjs", "writes": ["src/data/data-coverage/descriptive_data_coverage_audit.json"] },
    { "script": "scripts/historical-monthly-extension/audit.mjs", "writes": ["src/data/historical-extension-audit/*"] },
    { "script": "scripts/fetch-v12-panel-data.mjs", "writes": ["src/data/panel/*", "public/research-data/panel_runtime.json"] },
    { "script": "scripts/fetch-v075-cross-country-parity.mjs", "writes": ["src/data/observations/v075-cross-country-parity.json"] },
    { "script": "scripts/fetch-v080-china-trade.mjs", "writes": ["src/data/**"] },
    { "script": "scripts/fetch-v081-china-fdi.mjs", "writes": ["src/data/**"] },
    { "script": "scripts/build-spatial-data-v086.mjs", "writes": ["src/data/regional/*"] },
    { "script": "scripts/build-regional-economic-v089.mjs", "writes": ["src/data/regional/*"] },
    { "script": "scripts/acquire-comtrade-bilateral.mjs", "writes": [".tmp-comtrade (raw cache) → consumed by scripts/network/build-trade-network.mjs"] },
    { "script": "scripts/network/build-trade-network.mjs", "writes": ["src/data/network/*"] },
    { "script": "scripts/events/build-event-registries.mjs", "writes": ["src/data/events/*"] },
    { "script": "scripts/macro/build-var-readiness.mjs", "writes": ["src/data/macro/*", "src/data/analysis/*"] },
    { "script": "scripts/local-projections/build-local-projections.mjs", "writes": ["src/data/local-projections/*"] },
    { "script": "scripts/local-projections/build-lp-robustness.mjs", "writes": ["src/data/local-projections/*"] },
    { "script": "scripts/local-projections/finalize-finite-sample.mjs", "writes": ["src/data/local-projections/*"] },
    { "script": "scripts/local-projections/run-python-diagnostic.mjs", "writes": ["src/data/local-projections/*"] },
    { "script": "scripts/panel-local-projections/run.mjs", "writes": ["src/data/panel-local-projections/*"], "read_only_flags": ["validate", "robustness-validate", "composition", "build"], "unless_flags": ["--write-summary"], "note": "reference writes panel reference outputs; validate writes the summary only with --write-summary; build and composition print only" },
    { "script": "scripts/identified-shocks/build-information-effect-separation.mjs", "writes": ["src/data/identified-shocks/*"] },
    { "script": "scripts/var-residual-diagnostics/simulate.py", "writes": ["src/data/macro/var_residual_*"] },
    { "script": "scripts/var-residual-diagnostics/calibrate.py", "writes": ["src/data/macro/var_residual_*"] },
    { "script": "scripts/var-selection-aware-bootstrap/simulate.py", "writes": ["src/data/macro/var_selection_bootstrap_*"] },
    { "script": "scripts/var-selection-aware-bootstrap/calibrate.py", "writes": ["src/data/macro/var_selection_bootstrap_*"] },
    { "script": "scripts/var-lag-selection-characterization/run_simulation.py", "writes": ["src/data/macro/var_lag_characterization_*"] },
    { "script": "scripts/var-country-matched-bootstrap/run_simulation.py", "writes": ["src/data/macro/var_country_matched_*"] },
    { "script": "scripts/validation/generate-seasonal-adf-calibration.py", "writes": ["src/data/**"] },
    { "script": "scripts/validation/run-lp-reference.mjs", "writes": ["src/data/local-projections/lp_reference_cases.json"] },
    { "script": "scripts/validation/generate-lp-reference.py", "writes": ["src/data/local-projections/lp_reference_cases.json"] },
    { "script": "scripts/export-research-data.mjs", "writes": ["public/research-data/**", "src/data/analysis/advanced_analysis_validation_summary.json"] },
    { "script": "scripts/release/build-research-package.mjs", "writes": ["public/research-data/**"] },
    { "script": "scripts/data-refresh/apply.mjs", "writes": ["canonical descriptive stores listed in the accepted data_refresh_plan.json", "src/data/data-refresh/refresh_ledger.jsonl"] }
  ],
  "read_only": [
    { "script": "scripts/historical-annual/validate.mjs", "note": "imports build() from acquire.mjs and calls it with { offline: true }; the store/manifest writes sit behind acquire.mjs's main guard" },
    { "script": "scripts/historical-monthly-descriptive/validate.mjs", "note": "build({ offline: true }); writes behind the main guard" },
    { "script": "scripts/historical-regional/validate.mjs", "note": "build({ offline: true }); writes behind the main guard" },
    { "script": "scripts/serbia-sors/validate.mjs", "note": "build({ offline: true }); writes behind the main guard" },
    { "script": "scripts/data-coverage/validate.mjs", "note": "imports audit helpers only" },
    { "script": "scripts/data-refresh/plan.mjs", "note": "stages every acquisition in a scratch copy under .tmp-data-refresh/; never writes the canonical trees (the PostToolUse detector verifies this on every run)" },
    { "script": "scripts/var-selection-aware-bootstrap/reference.py", "requires_flags": ["--check"], "note": "--check compares against the committed file and exits" },
    { "script": "scripts/var-lag-selection-characterization/reference.py", "requires_flags": ["--check"], "note": "--check compares against the committed file and exits" },
    { "script": "scripts/var-country-matched-bootstrap/reference.py", "requires_flags": ["--check"], "note": "--check compares against the committed file and exits" },
    { "script": "scripts/validation/validate-local-projections.mjs", "requires_flags": ["--read-only"], "note": "without --read-only it rewrites lp_validation_summary.json" }
  ]
}
