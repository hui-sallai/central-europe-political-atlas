{
  "name": "central-europe-political-atlas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/security/check-public-secrets.mjs && node scripts/macro/build-var-readiness.mjs && pnpm lp:build && pnpm lp:robustness && pnpm lp:reference && pnpm lp:validate && node scripts/export-research-data.mjs && node scripts/release/build-research-package.mjs && node scripts/validation/run-research-validation.mjs && node scripts/validation/validate-ecb-shocks.mjs && node scripts/validation/run-advanced-analysis-validation.mjs && node scripts/validation/run-ui-language-qa.mjs && node scripts/build-home-country-map.mjs && next build && node scripts/release/validate-release.mjs",
    "build:site": "node scripts/build-home-country-map.mjs && next build",
    "map:home": "node scripts/build-home-country-map.mjs",
    "sandbox:hungary-boundary": "node scripts/build-hungary-boundary-sandbox.mjs",
    "export:research-data": "node scripts/export-research-data.mjs",
    "package:research-data": "node scripts/release/build-research-package.mjs",
    "research:validate": "node scripts/validation/run-research-validation.mjs",
    "analysis:validate": "node scripts/validation/validate-ecb-shocks.mjs && node scripts/validation/run-advanced-analysis-validation.mjs",
    "ecb:acquire": "python scripts/acquisition/acquire-ecb-monetary-events.py --refresh",
    "ecb:build": "python scripts/acquisition/acquire-ecb-monetary-events.py",
    "ecb:validate": "node scripts/validation/validate-ecb-shocks.mjs",
    "jk:build": "node scripts/identified-shocks/build-information-effect-separation.mjs",
    "jk:validate": "node scripts/validation/validate-information-effect-separation.mjs && python3 scripts/validation/validate-jk-author-reference.py",
    "author-reference:validate": "python3 scripts/validation/validate-jk-author-reference.py",
    "information-effect:validate": "node scripts/validation/validate-information-effect-separation.mjs && python3 scripts/validation/validate-jk-author-reference.py",
    "macro:build": "node scripts/macro/build-var-readiness.mjs",
    "lp:build": "node scripts/local-projections/build-local-projections.mjs",
    "lp:robustness": "node scripts/local-projections/build-lp-robustness.mjs",
    "lp:reference": "node scripts/validation/run-lp-reference.mjs",
    "lp:validate": "node scripts/validation/validate-local-projections.mjs",
    "lp:path-reference": "node scripts/validation/run-lp-reference.mjs",
    "lp:path-validate": "node scripts/validation/validate-local-projections.mjs",
    "lp:finite-sample": "node scripts/local-projections/run-python-diagnostic.mjs finite-sample",
    "lp:shock-support": "node scripts/local-projections/run-python-diagnostic.mjs shock-support",
    "lp:loo-validate": "node scripts/validation/validate-lp-finite-sample.mjs && node scripts/local-projections/finalize-finite-sample.mjs",
    "var:reference": "python scripts/validation/generate-var-reference.py",
    "var:calibrate-seasonal-adf": "python scripts/validation/generate-seasonal-adf-calibration.py",
    "ui-language:qa": "node scripts/validation/run-ui-language-qa.mjs",
    "events:build": "node scripts/events/build-event-registries.mjs",
    "hf:acquire": "node scripts/acquire-eurostat-monthly.mjs",
    "hf:migration-qa": "node scripts/hicp-migration-qa.mjs",
    "macro:acquire-drivers": "python scripts/acquisition/acquire-macro-drivers.py && python scripts/acquisition/acquire-ecb-monetary-events.py",
    "release:validate": "node scripts/release/validate-release.mjs",
    "security:scan": "node scripts/security/check-public-secrets.mjs",
    "network:acquire": "node scripts/acquire-comtrade-bilateral.mjs",
    "network:build": "node scripts/network/build-trade-network.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "next start",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
