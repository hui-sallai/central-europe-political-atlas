    "var:residual-simulate": ".venv/bin/python scripts/var-residual-diagnostics/simulate.py",
    "var:residual-calibrate": ".venv/bin/python scripts/var-residual-diagnostics/calibrate.py",
    "var:residual-validate": ".venv/bin/python scripts/var-residual-diagnostics/validate.py",
    "var:residual-closure-validate": "node scripts/var-residual-diagnostics/closure_validate.mjs",
    "var:residual-decompose": "python3 scripts/var-residual-diagnostics/decompose_selection.py",
    "var:residual-decomposition-validate": "python3 scripts/var-residual-diagnostics/validate_decomposition.py",
    "analysis:validate": "node scripts/validation/validate-analysis-registry.mjs && node scripts/validation/validate-ecb-shocks.mjs && node scripts/validation/run-advanced-analysis-validation.mjs",
