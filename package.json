    "var:calibrate-seasonal-adf": "python scripts/validation/generate-seasonal-adf-calibration.py",
    "ui-language:qa": "node scripts/validation/run-ui-language-qa.mjs",
    "events:build": "node scripts/events/build-event-registries.mjs",
    "hf:acquire": "node scripts/acquire-eurostat-monthly.mjs",
    "hf:migration-qa": "node scripts/hicp-migration-qa.mjs",
    "macro:acquire-drivers": "python scripts/acquisition/acquire-macro-drivers.py && python scripts/acquisition/acquire-ecb-monetary-events.py",
    "release:validate": "node scripts/release/validate-release.mjs",
    "security:scan": "node scripts/security/check-public-secrets.mjs",
    "network:acquire": "node scripts/acquire-comtrade-bilateral.mjs",
    "network:build": "node scripts/network/build-trade-network.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "next start",
    "start": "next start",
    "lint": "eslint ."
