{
  "name": "central-europe-political-atlas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/security/check-public-secrets.mjs && node scripts/export-research-data.mjs && node scripts/release/build-research-package.mjs && node scripts/validation/run-research-validation.mjs && node scripts/build-home-country-map.mjs && next build && node scripts/release/validate-release.mjs",
    "build:site": "node scripts/build-home-country-map.mjs && next build",
    "map:home": "node scripts/build-home-country-map.mjs",
    "sandbox:hungary-boundary": "node scripts/build-hungary-boundary-sandbox.mjs",
    "export:research-data": "node scripts/export-research-data.mjs",
    "package:research-data": "node scripts/release/build-research-package.mjs",
    "research:validate": "node scripts/validation/run-research-validation.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "security:scan": "node scripts/security/check-public-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "next start",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.106.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
