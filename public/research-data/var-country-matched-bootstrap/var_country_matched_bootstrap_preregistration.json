      0.5,
      0.75,
      1.0,
      1.25,
      1.5,
      2.0
    ],
    "intermediate_region": [
      0.75,
      1.0,
      1.25
    ],
    "innovations": "Gaussian iid (null); preregistered serial alternatives (power)"
  },
  "null_designs": "84 correctly specified stable VAR(1) / VAR(2) cells (2 det x 3 persistence x 2 covariances x 7 designs); all feasible",
  "alternatives": {
    "families": {
      "common_ar1": [
        0.1,
        0.2,
        0.3
      ],
      "seasonal_ar12": [
        0.1,
