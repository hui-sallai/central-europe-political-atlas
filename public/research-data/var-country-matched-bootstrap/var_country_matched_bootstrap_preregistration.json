        0.3
      ]
    },
    "base_designs": [
      "p1",
      "p2_psi0.75",
      "p2_psi1.00",
      "p2_psi1.25"
    ],
    "cells": 288,
    "note": "residual dependence outside any finite VAR in the candidate set; seasonal AR(12) cannot be absorbed by lags <= 10"
  },
  "bootstrap": {
    "engine": "frozen v1.86 engine.run_procedure unmodified",
    "family": "recursive_iid_residual",
    "B": 199,
    "bic_rerun_inside_every_bootstrap_sample": true,
    "p_value": "(1 + #{tau*_b <= tau}) / (B+1); reject iff <= 0.05",
    "B_note": "B=199 matches the v1.86 synthetic calibration; v1.88 Phase B used B=1999 on single series. The bootstrap test's size is exact under exchangeability for any B with alpha(B+1) integer; B affects p-value Monte Carlo noise and slightly power (Davidson and MacKinnon 2000)."
  },
  "asymptotic_comparison": "every replication also records the asymptotic chi-square h=12 adjusted Portmanteau p-value at the BIC-selected lag (production diagnostic)",
  "replications": {
    "null_per_cell": 2000,
    "power_per_cell": 500,
    "total_monte_carlo": 312000,
    "total_bootstrap_draws": 62088000
  },
  "alpha": 0.05,
  "estimands": {
    "primary_size": "S_adequate = P(bootstrap reject | selected lag >= true lag), null cells; evaluable when >= 500 such replications (v1.86 selected-model-adequacy estimand)",
    "conservatism_focus": "S_correct = P(bootstrap reject | selected lag = true lag) for true-p2 cells, reported with Wilson 95% intervals",
    "procedure_rate": "S_procedure = unconditional bootstrap rejection rate (labelled selection-aware procedure rejection rate, not size)",
    "power": "P(bootstrap reject) under each alternative cell, all cells reported",
    "comparisons": [
      "asymptotic analogue of every estimand",
      "BIC exact-recovery rate",
      "bootstrap-selected-lag distribution",
      "computational failure rate",
      "Monte Carlo SE and Wilson 95% interval"
    ]
  },
  "acceptable_size_interval": {
    "interval": [
      0.035,
      0.065
    ],
    "maximum": 0.075,
    "fraction_inside_required": 0.9,
    "rationale": "identical interval philosophy to v1.85/v1.86"
  },
  "classification_rules": {
    "materially_conservative_cell": "S_adequate < 0.035 AND Wilson 95% upper bound < 0.05",
    "size_status": {
      "approximately_nominal": "every evaluable null cell S_adequate <= 0.075 AND >= 90% inside [0.035, 0.065]",
      "materially_conservative": "not approximately_nominal, no evaluable cell > 0.075, and >= 25% of evaluable intermediate-region (psi 0.75/1.00/1.25) cells materially conservative",
      "poorly_calibrated": "otherwise"
    },
    "power_status": {
      "useful": "for both alternative families, the median bootstrap rejection across all 72 base cells is >= 0.80 at strength 0.3 AND >= 0.50 at strength 0.2",
      "weak": "otherwise"
    },
    "outcome": {
      "A": "approximately_nominal and useful power",
      "B": "materially_conservative and useful power",
      "C": "materially_conservative and weak power",
      "D": "poorly_calibrated",
      "E": "approximately_nominal but weak power (added so every combination is covered)"
    },
    "disposition": {
      "A_or_B": "country_matched_calibration_supports_future_production_decision_research",
      "C_D_or_E": "country_matched_calibration_does_not_support_production_adoption"
    },
    "production_change_authorized": false
  },
  "failure_handling": "engine states other than 'ok' are counted as computational failures, excluded from rejection denominators and reported per cell; no retries or replacement draws",
  "stopping_rule": "run every preregistered null and power chunk to completion; no early stopping; stop after calibration summary and owner report; retain all checkpoints",
  "interpretation_rules": [
    "no outcome authorizes a production change; production_change_authorized = false",
    "S_procedure is never called size",
    "power is reported for every cell including low-power cells",
    "country outcomes are not re-evaluated or re-run"
  ],
  "prohibited": [
    "changing bootstrap family, B, BIC, candidate lags, transformations or deterministic specifications",
    "tuning cells to individual countries or using country pass/fail for parameters",
    "changing thresholds, envelope, alternatives, replications or seeds after any confirmatory draw",
    "rerunning Phase B",
    "modifying v1.85-v1.88 artifacts",
    "IRF, SVAR, BVAR or readiness changes"
  ],
  "production_boundary": {
