  },
  "envelope": {
    "T": 137,
    "K": 3,
    "candidate_lags": "1..10 production policy",
    "true_lags": [
      1,
      2
    ],
    "deterministic": [
      "constant",
      "constant + 11 month dummies"
    ],
    "persistence": [
      0.92,
      0.95,
      0.97
    ],
    "covariances": [
      "v185_positive",
      "envelope_mixed_sign (|rho|<=0.40)"
    ],
