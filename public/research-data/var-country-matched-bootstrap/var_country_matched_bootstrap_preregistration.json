  ],
  "research_question": "Does the v1.86 recursive iid-residual selection-aware bootstrap have acceptable finite-sample size and power in synthetic designs matched to the platform's country VAR environment, especially the intermediate lag-2 identification region of the four v1.88 lag-2 units; is it materially conservative there?",
  "known_information_disclosure": {
    "known": [
      "v1.85-v1.88 results including the v1.88 country bootstrap and asymptotic p-values",
      "v1.87 descriptive finding: bootstrap rejection given correct recovery was ~1.9% in psi=1 designs"
    ],
    "envelope_use": "v1.88 used only for pooled envelope ranges (persistence, correlations, ELI range); no cell tuned to a country; country pass/fail outcomes not used for any parameter",
    "smoke": "phase code 1 checked determinism and timing only"
  },
  "design_reference": {
    "file": "var_country_matched_bootstrap_simulation_design.json",
    "sha256": "f7e0bca8926c06d08e8baba50c6e9eff0c2025f29dd24007e346de4b6412cc0a"
