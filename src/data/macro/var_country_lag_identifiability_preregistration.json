    "known_before_preregistration": [
      "published v1.84+ estimable lists (v1: poland, romania; v2: czechia, germany, hungary)",
      "published fact that the formal dynamic-response-ready country count is zero",
      "v1.85-v1.87 synthetic results"
    ],
    "not_inspected_for_this_preregistration": [
      "per-country selected lags, BIC values, residual statistics, stability values or readiness blocking reasons (the readiness fields listed as not read in the design were not read or printed while preparing v1.88)"
    ],
    "caveat": "earlier releases published per-country readiness details, so prior exposure to some production outcomes cannot be ruled out; v1.88 metrics, mapping bands and categories were fixed without reference to them"
  },
  "interpretation_rules": [
    "ELI is an empirical index, never 'true psi', never a probability that p=2 is true, and psi = 1 is not a cutoff",
    "v1.87 mapping is descriptive context only",
    "underselection relative to a larger estimated model is not called misspecification",
    "asymptotic Portmanteau results are the existing production diagnostic and carry the v1.85 calibration caveat",
    "no country result changes readiness, BIC, the production diagnostic or IRF availability"
  ],
  "stopping_rule": "Phase A (audit) runs once per eligible unit only after explicit owner approval, with no alternative samples, transformations, lag sets or seeds; stop and report. Phase B runs only after a further explicit owner approval.",
  "prohibited": [
    "changing BIC, candidate lags, transformations, deterministic terms or raw observations",
    "activating AIC/HQIC",
    "adding/removing countries based on outcomes",
    "using ELI or v1.87 bands as a gate",
    "tuning metrics or bands after inspecting country outcomes",
    "publishing formal IRFs",
    "activating SVAR/BVAR",
    "modifying v1.85-v1.87 artifacts"
  ],
